# Factory parameters, sourced by infra/lib.sh. NO SECRETS HERE: tokens live in Secret Manager.
# To build another factory, copy this file (and infra/deploy-config.json), change the values,
# and follow docs/scion/02-runbook-from-zero.md. Project ID, region and hub name come from
# deploy-config.json, because Scion's deploy.sh reads them from there.

# Google Cloud organization
FOLDER_ID="<folder-id>"                       # folder the project is created under
BILLING_ACCOUNT="<XXXXXX-XXXXXX-XXXXXX>"
ORG_DOMAIN="example.com"                    # domain allowed to use the operator CLI via federation
WEB_DOMAINS="example.com"                   # domains allowed through IAP into the UIs
ADMIN_EMAIL="po@example.com"                # hub super-admin; the lead messages this user
DEFAULT_USER_ROLE="viewer"                  # role for new web users (viewer = cannot start agents)

# Source repository the factory works on
GITHUB_REPO="<owner>/<repo>"
HUB_PROJECT_SLUG="<owner>-<repo>"           # slug the hub derives from the repo URL

# Pinned versions (reproducibility)
SCION_VERSION="nightly-20261009"                                    # Scion release for the hub and deploy.sh
AGENT_TEAM_SHA="3650f1b03411116fcbf37852bfec6911db64b569"           # scion-frontiers/agent-team
IMPECCABLE_SHA="d631a8827f99414d2b6daba4ef08b7f8701751d7"           # pbakaus/impeccable (frontend skill)

# Operating model and cost
BUDGET_USD="2000"                    # monthly budget; at 100% the guard suspends agents (never stops the VM)
TICK_CRON="0 */6 * * *"              # lead loop safety-net schedule (UTC); watchdog wakes on change every 5 min
DEPLOY_ZONE="us-central1-a"                 # pick a zone with capacity for the machine size

# Constant: the gcloud CLI's OAuth client ID (audience of `gcloud auth print-identity-token`)
GCLOUD_CLIENT_ID="32555940559.apps.googleusercontent.com"

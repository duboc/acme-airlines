# Public factory parameters, sourced by infra/lib.sh.
#
# Sensitive organization, billing, and domain parameters NEVER live in this
# tracked file. Put them in gitignored `infra/factory.local.env` (also backed up
# in GCP Secret Manager as `<hub_name>-factory-local-env`):
#
#   FOLDER_ID="000000000000"                       # GCP folder ID the project lives under
#   BILLING_ACCOUNT="000000-000000-000000"         # GCP billing account ID
#   ORG_DOMAIN="corp.example.com"                  # Workspace domain for operator CLI federation
#   WEB_DOMAINS="corp.example.com partner.example.com" # Workspace domains allowed through IAP
#   ADMIN_EMAIL="admin@corp.example.com"           # Hub super-admin & product owner email

# Default role for new web users signing in via IAP (viewer = cannot start agents)
DEFAULT_USER_ROLE="viewer"

# Source repository the factory works on
GITHUB_REPO="duboc/acme-airlines"              # owner/repo
HUB_PROJECT_SLUG="duboc-acme-airlines"         # slug the hub derives from the repo URL (<owner>-<repo>)

# Pinned versions (reproducibility)
SCION_VERSION="nightly-20261009"                                    # Scion release for the hub and deploy.sh
AGENT_TEAM_SHA="3650f1b03411116fcbf37852bfec6911db64b569"           # scion-frontiers/agent-team
IMPECCABLE_SHA="d631a8827f99414d2b6daba4ef08b7f8701751d7"           # pbakaus/impeccable (frontend skill)

# Operating model and cost
BUDGET_USD="2000"                    # monthly budget; at 100% the guard suspends agents (never stops the VM)
WATCHDOG_CRON="0 * * * *"            # hourly wake-on-change + self-healing check (UTC)
TICK_CRON="0 */6 * * *"              # lead loop safety-net schedule (UTC); watchdog wakes on change every hour
DEPLOY_ZONE="us-central1-a"          # zone override for deploy.sh (it otherwise picks the region's first zone)

# Constant: the gcloud CLI's public OAuth client ID (audience of `gcloud auth print-identity-token`)
GCLOUD_CLIENT_ID="32555940559.apps.googleusercontent.com"
